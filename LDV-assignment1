<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>PSI Readings Table</title>
    <style>
        table {
            border-collapse: collapse;
            width: 75%;
            margin: 40px auto;
        }
        th, td {
            border: 1px solid #444;
            padding:12px;
            text-align:center;
        }
        th {
            background-color: #eeeeee;
        }
        h1 {
            text-align:center;
        }
    </style>
</head>
<body>
    <h1>Singapore PSI Realtime Readings</h1>
    <table>
        <thead>
            <tr>
                <th>Reading Name</th>
                <th>Value</th>
            </tr>
        </thead>
        <tbody id="psiTableBody"></tbody>
    </table>

    <script>
        const apiUrl = "https://data.gov.sg/api/action/datastore_search?resource_id=d_fe37906a0182569d891506e815e819b7";
        const readingList = [
            "o3_sub_index",
            "pm10_sub_index",
            "co_sub_index",
            "pm25_sub_index",
            "so2_sub_index",
            "no2_sub_index",
            "psi_twenty_four_hourly",
            "o3_eight_hour_max",
            "co_eight_hour_max",
            "so2_24hr",
            "pm10_24hr",
            "pm25_24hr"
        ];

        fetch(apiUrl)
            .then(response => response.json())
            .then(jsonData => {
                const latestRecord = jsonData.result.records[0];
                const tableBody = document.getElementById("psiTableBody");
                readingList.forEach(keyName => {
                    const row = document.createElement("tr");
                    const cell1 = document.createElement("td");
                    const cell2 = document.createElement("td");
                    cell1.textContent = keyName;
                    cell2.textContent = latestRecord[keyName];
                    row.appendChild(cell1);
                    row.appendChild(cell2);
                    tableBody.appendChild(row);
                })
            })
            .catch(error => {
                console.log("API Fetch Error", error);
            })
    </script>
</body>
</html>
